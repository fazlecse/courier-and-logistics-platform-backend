model Delivery {
    id         String @id @default(uuid())
    trackingId String @unique

    senderName    String
    senderPhone   String
    senderAddress String

    receiverName    String
    receiverPhone   String
    receiverAddress String

    parcelType   String
    parcelWeight Float?
    expressDelivery Boolean @default(false)
    deliveryFee  Float

    status DeliveryStatus @default(PENDING)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
    isDeleted Boolean   @default(false)

    customerId String
    customer   User   @relation("CustomerDeliveries", fields: [customerId], references: [id])

    deliveryAgentId String?
    deliveryAgent   User?   @relation("AgentDeliveries", fields: [deliveryAgentId], references: [id])

    statusHistory DeliveryStatusHistory[]
    payment       Payment?

    @@index([customerId])
    @@index([deliveryAgentId])
    @@index([status])
    @@index([trackingId])
    @@index([createdAt])
    @@index([isDeleted])
    @@map("deliveries")
}
