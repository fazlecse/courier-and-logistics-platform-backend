model AuditLog {
    id String @id @default(uuid())

    userId      String?
    action      String
    entity      String
    entityId    String?
    description String?

    createdAt DateTime @default(now())

    user User? @relation(fields: [userId], references: [id])

    @@index([userId])
    @@index([entity])
    @@index([createdAt])
    @@map("auditLogs")
}
